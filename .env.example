# Family onboarding / first Supabase slice
# Default mock keeps previews and tests working without keys.
ONBOARDING_BACKEND=mock

# Supabase (Sydney / ap-southeast-2). Never put SERVICE_ROLE in VITE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend email (server only)
RESEND_API_KEY=
EMAIL_FROM="Keystone Music HQ <noreply@keystonemusichq.com>"
APP_URL=https://keystone-piano-studio.vercel.app

# Cron: Authorization: Bearer CRON_SECRET
CRON_SECRET=
# Notification emails per rolling 24 hours (Resend free plan: 100/day shared with sign-in emails).
NOTIFY_DAILY_LIMIT=70

# Cloudflare Turnstile (ADR-039). Secret is server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Support address shown on /studio-enquiry (also mailto).
SUPPORT_EMAIL=support@example.com

# Keystone → studio subscription billing (Synoratech charging studios). Server only.
# Not Stripe Connect (teacher family payments stay mock until Connect is wired).
# Absent keys keep Checkout/portal unavailable; demo plan switches stay simulated.
# See docs/security/subscription-access.md and the live Stripe setup checklist.
STRIPE_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=

# Google Calendar one-way push (0010). Server only. Same Google Cloud project as Google sign-in is fine;
# add ${APP_URL}/calendar/google as an authorised redirect URI. See docs/security/calendar.md.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Bootstrap script only (never deploy these to Vercel):
# bun scripts/bootstrap-platform-admin.ts
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=

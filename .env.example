# Family onboarding / first Supabase slice
# Default mock keeps previews and tests working without keys.
ONBOARDING_BACKEND=mock

# Supabase (Sydney / ap-southeast-2). Never put SERVICE_ROLE in VITE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend email (server only)
RESEND_API_KEY=
EMAIL_FROM="Keystone Music HQ <noreply@keystonemusichq.com>"
APP_URL=https://keystone-piano-studio.vercel.app

# Cron: Authorization: Bearer CRON_SECRET
CRON_SECRET=

# Cloudflare Turnstile (ADR-039). Secret is server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Support address shown on /studio-enquiry (also mailto).
SUPPORT_EMAIL=support@example.com

# Bootstrap script only (never deploy these to Vercel):
# bun scripts/bootstrap-platform-admin.ts
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
